# توکن ربات تلگرام (از BotFather گرفته می‌شود)
# این فایل فقط نمونه است؛ توکن واقعی را اینجا ننویسید و فایل .env واقعی را
# هرگز برای کسی ارسال نکنید.
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# حالت اجرا: polling (توسعه محلی) یا webhook (روی سرور)
BOT_MODE=polling

# فقط برای حالت webhook لازم است؛ آدرس HTTPS عمومی سرور شما
WEBHOOK_URL=https://example.com

# پورتی که وب‌هوک روی آن گوش می‌دهد (فقط حالت webhook)
PORT=8443

# شناسه‌ی عددی مدیر در تلگرام (پنل مدیر فقط برای همین شناسه باز می‌شود)
# اگر خالی یا صفر باشد، پنل مدیر خاموش است.
ADMIN_USER_ID=0
